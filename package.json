{
  "name": "mediaxg",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Premium terminal-based AI coding agent with multi-provider support",
  "type": "module",
  "bin": {
    "mediaxg": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "diff": "^8.0.3",
    "glob": "^11.0.0",
    "ignore": "^6.0.0",
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "minimatch": "^10.0.0",
    "ora": "^8.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "react": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/bun": "^1.4.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "prettier": "^3.3.0",
    "react-devtools-core": "^5.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
